# URL Backend API (Opsional)
# Kosongkan untuk deploy single-domain (frontend & backend di-serve oleh satu proses Express
# yang sama) -- frontend otomatis pakai relative path /api/v1.
# Isi hanya jika frontend & backend sengaja dipisah ke domain/host berbeda:
#   VITE_API_URL=https://api.kmp-adng.id/api/v1
VITE_API_URL=

# Mode Aplikasi (development/production)
# Vite secara otomatis mengatur ini berdasarkan command (dev/build), tapi bisa di-override jika perlu
# VITE_APP_MODE=development
