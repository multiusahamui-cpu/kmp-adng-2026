# URL Backend API (Opsional)
# Jika kosong, akan menggunakan relative path /api/v1 (cocok untuk setup fullstack di port yang sama)
# Contoh untuk development ke backend remote: https://api.kmp-adng.id/api/v1
# Contoh untuk development local: http://localhost:3000/api/v1
VITE_API_URL=server.kmp-adng.id

# Mode Aplikasi (development/production)
# Vite secara otomatis mengatur ini berdasarkan command (dev/build), tapi bisa di-override jika perlu
# VITE_APP_MODE=development
